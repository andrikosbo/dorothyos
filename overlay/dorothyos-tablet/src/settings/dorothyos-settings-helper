  COSMIC Camera, and hundreds of other projects

Full list and licences:  /usr/share/doc/dorothyos-branding/CREDITS.md  and  /usr/share/licenses

DorothyOS is an independent project. It is not affiliated with or endorsed by the projects named above."""


def cmd_credits():
    rc, o, e = sh("kdialog", "--title", "Acknowledgements", "--msgbox", CREDITS_TEXT, timeout=600)
    out({"ok": rc == 0})


def main(argv):
    if not argv:
        print(__doc__); return 2
    c, a = argv[0], argv[1:]
    onoff = lambda i=0: (a[i] if len(a) > i else "on") == "on"
    if c == "state": cmd_state()
    elif c == "wifi-list": cmd_wifi_list()
    elif c == "wifi-connect": cmd_wifi_connect(a[0])
    elif c in ("wifi", "bt", "night", "rotlock", "dnd", "mute"):
        rc, o, e = sh(CC, c, "on" if onoff() else "off", timeout=30); out({"ok": rc == 0})
    elif c in ("bright", "volume"):
        rc, o, e = sh(CC, c, str(int(float(a[0])))); out({"ok": rc == 0})
    elif c == "bt-list": cmd_bt_list()
    elif c == "bt-connect": cmd_bt_connect(a[0], True)
    elif c == "bt-disconnect": cmd_bt_connect(a[0], False)
    elif c == "scale": cmd_scale(a[0])
    elif c == "dark": cmd_dark(onoff())
    elif c == "accent": cmd_accent(a[0])
    elif c == "kbd": cmd_kbd(onoff())
    elif c == "profile": cmd_profile(a[0])
    elif c == "dock-get": cmd_dock_get()
    elif c == "dock-set": cmd_dock_set(a)
    elif c == "icons-style":
        rc, o, e = sh(ICONS, "set", a[0], "force", timeout=60); out({"ok": rc == 0})
    elif c == "wallpaper-next":
        rc, o, e = sh(WALL, "next", timeout=40); out({"ok": rc == 0, "message": o[-200:]})
    elif c == "about": cmd_about()
    elif c == "credits": cmd_credits()
    else:
        print(__doc__); return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
