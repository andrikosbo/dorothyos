#!/usr/bin/env python3
# pipa-home-apps — every launchable desktop app as JSON for the home grid widget: [{"id","name","icon","path"}], sorted by name.
# Looks at the same directories as the app menu (user files win over system files with the same id) and leaves out hidden entries,
# System Settings modules, entries for other desktops and flatpak launchers whose app is no longer installed.
import glob, json, os, sys

home = os.path.expanduser("~")
data_dirs = [d for d in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":") if d]
dirs = [home + "/.local/share/applications",
        home + "/.local/share/flatpak/exports/share/applications",
        "/var/lib/flatpak/exports/share/applications"] + [d + "/applications" for d in data_dirs]
KEYS = ("Type", "Name", "Icon", "NoDisplay", "Hidden", "OnlyShowIn", "NotShowIn", "Exec", "X-KDE-ServiceTypes", "X-Flatpak", "TryExec")


def read_entry(path):
    ent, inside = {}, False
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if line.startswith("["):
                    if inside:
                        break
                    inside = line == "[Desktop Entry]"
                    continue
                if inside and "=" in line and not line.startswith("#"):
                    k, v = line.split("=", 1)
                    k = k.strip()
                    if k in KEYS:
                        ent.setdefault(k, v.strip())
    except OSError:
        return None
    return ent


def flatpak_installed(app):
    return any(os.path.isdir(os.path.join(b, "app", app)) for b in (home + "/.local/share/flatpak", "/var/lib/flatpak"))


seen, out = set(), []
for d in dirs:
    for path in sorted(glob.glob(d + "/*.desktop")):
        app_id = os.path.basename(path)[:-8]
        if app_id in seen:
            continue
        seen.add(app_id)
        e = read_entry(path)
        if not e or e.get("Type", "Application") != "Application":
            continue
        if e.get("NoDisplay", "").lower() == "true" or e.get("Hidden", "").lower() == "true":
            continue
        only, notshow = e.get("OnlyShowIn", ""), e.get("NotShowIn", "")
        if (only and "KDE" not in only.split(";")) or "KDE" in notshow.split(";"):
            continue
        if app_id.startswith("kcm_") or "kcmshell" in e.get("Exec", "") or "KCModule" in e.get("X-KDE-ServiceTypes", ""):
            continue
        if e.get("X-Flatpak") and not flatpak_installed(e["X-Flatpak"]):
            continue
        out.append({"id": app_id, "name": e.get("Name") or app_id, "icon": e.get("Icon") or "application-x-executable", "path": path})

out.sort(key=lambda a: a["name"].lower())
json.dump(out, sys.stdout, ensure_ascii=False)
